# ============================================================================
# ZSH Configuration - All Environments
# Collection of shell configuration for all my environments
# ============================================================================

# ----------------------------------------------------------------------------
# Package Managers & Environment Setup
# ----------------------------------------------------------------------------

# add this to my ~/.zshrc
# . ~/src/dotfiles/.zshrc_all

# ----------------------------------------------------------------------------
# Shell Appearance & Prompt
# ----------------------------------------------------------------------------

# Git branch helper function for prompt
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

# Prompt configuration for zsh
# Show current directory plus the git branch (in green)
setopt PROMPT_SUBST
autoload -U colors && colors
PROMPT='%~ %{$fg[green]%}$(parse_git_branch)%{$reset_color%} $ '

# ----------------------------------------------------------------------------
# Git Aliases & Functions
# ----------------------------------------------------------------------------

# Basic git operations
alias gs="git status"
alias ga="git add"
alias gas="git add src/*"

# Commit operations
alias gcom="git commit -m"
alias gcoa="git commit --amend"

# Branch operations
alias gch="git checkout"
alias gchm="git checkout main"

# Remote operations
alias gpl="git pull"
alias gph="git push -u origin"
alias gpf="git push --force-with-lease"
alias gp="git push"

# GitHub CLI integration
alias gpr="gh pr create -d"
alias gpv="gh pr view --web"

# Branch reset helpers
alias gkillmaster="git fetch origin && git reset --hard origin/master"
alias gkillmain="git fetch origin && git reset --hard origin/main"

# Reset any branch to origin
gkill() {
  if [ -z "$1" ]; then
    echo "Branch name required"
    return 1
  fi
  git fetch origin
  git checkout "$1"
  git reset --hard origin/"$1"
}

# Resolve the remote-tracking ref for the repo's default branch (origin/main, origin/master, ...)
_git_main_ref() {
  local head_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -n "$head_ref" ]; then
    echo "$head_ref"
    return 0
  fi
  local b
  for b in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      echo "origin/$b"
      return 0
    fi
  done
  return 1
}

# All worktrees live here, named <repo>-<branch>
GWT_ROOT="${GWT_ROOT:-$HOME/src/worktrees}"

# Path of the repo's main worktree, even when called from inside a linked worktree
_gwt_main_root() {
  git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'
}

# Full destination path for <branch>'s worktree in the current repo
_gwt_path() {
  local main_root=$(_gwt_main_root)
  if [ -z "$main_root" ]; then
    return 1
  fi
  echo "$GWT_ROOT/$(basename "$main_root")-${1}"
}

# Git worktree helpers
gwt() {
  if [ -z "$1" ]; then
    echo "Git worktree helpers:"
    echo "  gwt  <branch> [start-point]  Create worktree + branch, cd into it"
    echo "  gwtl                         List all worktrees"
    echo "  gwtr <branch>                Remove a worktree + its local branch"
    echo ""
    echo "Worktrees are created in $GWT_ROOT as <repo>-<branch>"
    echo ""
    echo "Examples:"
    echo "  gwt my-feature               Branch from up-to-date origin/main (default)"
    echo "  gwt my-feature HEAD          Branch from current HEAD instead"
    echo "  gwt my-feature v1.2.3        Branch from any commit, tag, or branch"
    return 1
  fi
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -z "$repo_root" ]; then
    echo "Not in a git repository"
    return 1
  fi
  local branch="$1"
  local worktree_path=$(_gwt_path "$branch")
  if [ -z "$worktree_path" ]; then
    echo "Could not determine the main worktree path"
    return 1
  fi
  mkdir -p "$GWT_ROOT" || return 1
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    echo "Using existing branch '$branch'"
    git worktree add "$worktree_path" "$branch" && cd "$worktree_path"
  elif [ -n "$2" ]; then
    echo "Creating new branch '$branch' from '$2'"
    git worktree add --no-track -b "$branch" "$worktree_path" "$2" && cd "$worktree_path"
  else
    echo "Fetching origin..."
    if ! git fetch --quiet origin; then
      echo "'git fetch origin' failed - not creating the worktree"
      return 1
    fi
    local main_ref=$(_git_main_ref)
    if [ -z "$main_ref" ]; then
      echo "Could not determine the default branch (no origin/HEAD, origin/main, or origin/master)"
      echo "Pass a start point explicitly: gwt $branch <start-point>"
      return 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
      echo "Note: uncommitted changes in $repo_root are untouched and stay there"
    fi
    echo "Creating new branch '$branch' from '$main_ref'"
    git worktree add --no-track -b "$branch" "$worktree_path" "$main_ref" && cd "$worktree_path"
  fi
  if [ ! -d "$worktree_path" ]; then
    echo "Worktree creation failed"
    return 1
  fi
  if [ -d "$repo_root/.claude" ]; then
    cp -r "$repo_root/.claude" "$worktree_path/.claude"
    echo "Copied .claude settings"
  fi
}

alias gwtl="git worktree list"

gwtr() {
  if [ -z "$1" ]; then
    echo "Usage: gwtr <branch-name>"
    return 1
  fi
  local branch="$1"
  local worktree_path=$(_gwt_path "$branch")
  local main_root=$(_gwt_main_root)
  if [ -z "$worktree_path" ] || [ -z "$main_root" ]; then
    echo "Not in a git repository"
    return 1
  fi
  # Step out of the worktree before deleting it, or the shell is left in a dead directory
  local start_dir=$PWD
  local moved=""
  if [ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$worktree_path" ]; then
    cd "$main_root" || return 1
    moved=1
  fi
  if ! git worktree remove "$worktree_path"; then
    cd "$start_dir" 2>/dev/null
    return 1
  fi
  echo "Removed worktree $worktree_path"
  if [ -n "$moved" ]; then
    echo "Moved to $main_root"
  fi
  local branch_sha=$(git rev-parse --short "$branch" 2>/dev/null)
  if [ -z "$branch_sha" ]; then
    return 0
  fi
  if git branch -d "$branch" >/dev/null 2>&1; then
    echo "Deleted local branch '$branch' (merged)"
  elif git branch -D "$branch" >/dev/null 2>&1; then
    echo "Deleted local branch '$branch' (was $branch_sha, not merged)"
    echo "Recover it with: git branch $branch $branch_sha"
  else
    echo "Could not delete local branch '$branch' - is it checked out elsewhere?"
  fi
}

# ----------------------------------------------------------------------------
# General Aliases
# ----------------------------------------------------------------------------

# Directory listing
alias la="ls -a"
alias ll="ls -la"

# Shell management
alias reload="source ~/.zshrc"

# Development tools
alias mcp-inspect="npx @modelcontextprotocol/inspector"
alias nu='nvm use'
alias nr="npm run"

# ----------------------------------------------------------------------------
# Custom Scripts & Functions
# ----------------------------------------------------------------------------

# Auto-switch Node version when entering directories with .nvmrc
_nvmrc_hook() {
  if [[ $PWD == $PREV_PWD ]]; then
    return
  fi
  
  PREV_PWD=$PWD
  [[ -f ".nvmrc" ]] && nvm use
}

# Register the nvm hook for zsh
autoload -U add-zsh-hook
add-zsh-hook chpwd _nvmrc_hook
add-zsh-hook precmd _nvmrc_hook

autoload -Uz compinit && compinit

# ----------------------------------------------------------------------------
# History Search & Navigation
# ----------------------------------------------------------------------------

# Up/Down arrow history substring search (fish-style)
# Type a few chars, then Up/Down to cycle through matching commands
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end

for map in emacs viins; do
  bindkey -M $map '^[[A' history-beginning-search-backward-end  # Up arrow
  bindkey -M $map '^[[B' history-beginning-search-forward-end  # Down arrow
done