# Ruby version management
eval "$(rbenv init - zsh)"

# Python version management via uv
export UV_PYTHON=3.13

pyuse() {
  local py
  py=$(uv python find "$1" 2>/dev/null)
  if [[ -z "$py" ]]; then
    echo "Python $1 not found. Run: uv python install $1"
    return 1
  fi
  export UV_PYTHON="$1"
  ln -sf "$py" ~/.local/bin/python
  ln -sf "$py" ~/.local/bin/python3
  echo "Switched to $(python --version)"
}

